PORT=3000
NODE_ENV=development

# Konfigurasi Database (Laragon MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=findcampus
DB_PORT=3306

# Keamanan & Autentikasi
JWT_SECRET=ganti_dengan_string_acak_yang_panjang
ALLOWED_EMAIL_DOMAINS=@unila.ac.id,@students.unila.ac.id,@staff.unila.ac.id,@mail.unila.ac.id,@pasca.unila.ac.id

# Pengiriman kode OTP lewat email (SMTP). Contoh Gmail: aktifkan verifikasi 2 langkah,
# lalu buat "App Password" dan isi di SMTP_PASS. Jika dikosongkan, kode OTP hanya
# dicetak di terminal server (mode pengembangan).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FindIT Campus" <emailkamu@gmail.com>
